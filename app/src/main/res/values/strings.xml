    <!-- About & Disclaimer -->
    <string name="about_title">About &amp; Privacy Transparency</string>
    <string name="about_ownership_heading">Personal Local Network Administration</string>
    <string name="about_ownership_body">Network Commander is a personal administration tool designed exclusively for managing your own local Wi-Fi and Ethernet network via your self-hosted Pi-hole DNS sinkhole running on your Network Attached Storage (NAS). You are responsible for configuring and administering your private network environment.</string>
    <string name="about_encryption_heading">DNS Metadata vs. Encrypted Traffic</string>
    <string name="about_encryption_body">Important Technical Transparency: Pi-hole only resolves domain names (e.g., example.com) and does NOT have access to the encrypted contents of your network traffic. All HTTPS, TLS, encrypted messaging, and application payloads remain fully encrypted end-to-end between your devices and remote endpoints. Pi-hole and this app can never see passwords, message bodies, video feeds, or search contents.</string>
    <string name="about_telemetry_heading">How Telemetry Works</string>
    <string name="about_telemetry_body">The application does not intercept network packets on this Android device. Instead, it reads aggregated DNS statistics and domain queries directly from your Pi-hole REST API at /api/stats/summary and /api/queries over your local Wi-Fi.</string>
